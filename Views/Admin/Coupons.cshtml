@model IEnumerable<EcommercePWA.Models.Coupon>
@{
    ViewData["Title"] = "Gerenciar Cupons";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="fas fa-ticket-alt me-2"></i>
                                Gerenciar Cupons
                            </h4>
                            <p class="mb-0 opacity-75">Gerencie cupons de desconto e promoções</p>
                        </div>
                        <div>
                            <a href="@Url.Action("Index", "Admin")" class="btn btn-light me-2">
                                <i class="fas fa-arrow-left me-2"></i>Voltar
                            </a>
                            <a href="@Url.Action("Create", "Coupon")" class="btn btn-warning">
                                <i class="fas fa-plus me-2"></i>Novo Cupom
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Conteúdo -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhum cupom encontrado</h5>
                            <p class="text-muted">Comece criando seu primeiro cupom de desconto.</p>
                            <a href="@Url.Action("Create", "Coupon")" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Criar Primeiro Cupom
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Descrição</th>
                                        <th>Desconto</th>
                                        <th>Validade</th>
                                        <th>Status</th>
                                        <th>Usos</th>
                                        <th class="text-center">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var coupon in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong class="text-primary">@coupon.Code</strong>
                                            </td>
                                            <td>
                                                @coupon.Description
                                            </td>
                                            <td>
                                                @if (coupon.DiscountAmount > 0)
                                                {
                                                    <span class="badge bg-success">R$ @coupon.DiscountAmount.ToString("N2")</span>
                                                }
                                                @if (coupon.DiscountPercentage > 0)
                                                {
                                                    <span class="badge bg-info">@coupon.DiscountPercentage?.ToString("N1")%</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    <div>De: @coupon.ValidFrom.ToString("dd/MM/yyyy")</div>
                                                    <div>Até: @coupon.ValidUntil.ToString("dd/MM/yyyy")</div>
                                                </small>
                                            </td>
                                            <td>
                                                @if (coupon.IsActive)
                                                {
                                                    <span class="badge bg-success">Ativo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inativo</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    @coupon.CurrentUses / @(coupon.MaximumUses?.ToString() ?? "∞")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-outline-info btn-sm" href="@Url.Action("Details", "Coupon", new { id = coupon.Id })" title="Detalhes">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a class="btn btn-outline-warning btn-sm" href="@Url.Action("Edit", "Coupon", new { id = coupon.Id })" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Delete", "Coupon", new { id = coupon.Id })" title="Excluir">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
