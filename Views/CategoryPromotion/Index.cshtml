@model List<EcommercePWA.Models.CategoryPromotion>

@{
    ViewData["Title"] = "Promoções por Categoria";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-tags me-2"></i>
                        Promoções por Categoria
                    </h3>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        Nova Promoção
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nome</th>
                                        <th>Categoria</th>
                                        <th>Desconto</th>
                                        <th>Período</th>
                                        <th>Status</th>
                                        <th>Prioridade</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var promotion in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@promotion.Name</strong>
                                                @if (!string.IsNullOrEmpty(promotion.Description))
                                                {
                                                    <br><small class="text-muted">@promotion.Description</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@promotion.CategoryName</span>
                                            </td>
                                            <td>
                                                @if (promotion.DiscountAmount.HasValue)
                                                {
                                                    <span class="badge bg-success">R$ @promotion.DiscountAmount.Value.ToString("F2")</span>
                                                }
                                                else if (promotion.DiscountPercentage.HasValue)
                                                {
                                                    <span class="badge bg-warning">@promotion.DiscountPercentage.Value.ToString("F1")%</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    <strong>De:</strong> @promotion.ValidFrom.ToString("dd/MM/yyyy")<br>
                                                    <strong>Até:</strong> @promotion.ValidUntil.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                @if (promotion.IsActive && promotion.IsValidNow())
                                                {
                                                    <span class="badge bg-success">Ativa</span>
                                                }
                                                else if (promotion.IsActive && promotion.ValidFrom > DateTime.Now)
                                                {
                                                    <span class="badge bg-warning">Agendada</span>
                                                }
                                                else if (promotion.IsActive && promotion.ValidUntil < DateTime.Now)
                                                {
                                                    <span class="badge bg-secondary">Expirada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inativa</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@promotion.Priority</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@promotion.Id" 
                                                       class="btn btn-sm btn-outline-info" title="Detalhes">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@promotion.Id" 
                                                       class="btn btn-sm btn-outline-primary" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Toggle" asp-route-id="@promotion.Id" 
                                                       class="btn btn-sm @(promotion.IsActive ? "btn-outline-warning" : "btn-outline-success")" 
                                                       title="@(promotion.IsActive ? "Desativar" : "Ativar")">
                                                        <i class="fas fa-@(promotion.IsActive ? "pause" : "play")"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@promotion.Id" 
                                                       class="btn btn-sm btn-outline-danger" title="Excluir">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma promoção cadastrada</h5>
                            <p class="text-muted">Crie sua primeira promoção por categoria para começar.</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>
                                Criar Primeira Promoção
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
