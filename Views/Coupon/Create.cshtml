@model EcommercePWA.Models.Coupon
@{
    ViewData["Title"] = "Novo Cupom";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-ticket-alt me-2"></i>Novo Cupom</h4>
                </div>
                <div class="card-body">
                    <!-- Exibir erros de validação gerais -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <h5><i class="fas fa-exclamation-triangle me-2"></i>Erros de Validação</h5>
                            <div asp-validation-summary="All" class="text-danger"></div>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        <div class="row">
                            <!-- Informações Básicas -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">Informações Básicas</h5>
                                
                                <div class="mb-3">
                                    <label asp-for="Code" class="form-label"></label>
                                    <input asp-for="Code" class="form-control" placeholder="Ex: DESCONTO10" />
                                    <span asp-validation-for="Code" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="Description" class="form-label"></label>
                                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descreva o cupom..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="IsActive" class="form-label"></label>
                                    <div class="form-check">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                        <label class="form-check-label" asp-for="IsActive">
                                            Cupom ativo
                                        </label>
                                    </div>
                                    <span asp-validation-for="IsActive" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <!-- Configurações de Desconto -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">Configurações de Desconto</h5>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountAmount" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text">R$</span>
                                                <input asp-for="DiscountAmount" class="form-control" placeholder="0,00" type="number" step="0.01" min="0" />
                                            </div>
                                            <span asp-validation-for="DiscountAmount" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="DiscountPercentage" class="form-label"></label>
                                            <div class="input-group">
                                                <input asp-for="DiscountPercentage" class="form-control" placeholder="0" type="number" step="0.1" min="0" max="100" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="MinimumOrderAmount" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">R$</span>
                                        <input asp-for="MinimumOrderAmount" class="form-control" placeholder="0,00" type="number" step="0.01" min="0" />
                                    </div>
                                    <span asp-validation-for="MinimumOrderAmount" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="MaximumUses" class="form-label"></label>
                                    <input asp-for="MaximumUses" class="form-control" placeholder="0 = ilimitado" type="number" min="0" />
                                    <small class="form-text text-muted">Deixe em 0 para uso ilimitado</small>
                                    <span asp-validation-for="MaximumUses" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Período de Validade -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5 class="text-primary mb-3">Período de Validade</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="ValidFrom" class="form-label"></label>
                                            <input asp-for="ValidFrom" class="form-control" type="datetime-local" />
                                            <span asp-validation-for="ValidFrom" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="ValidUntil" class="form-label"></label>
                                            <input asp-for="ValidUntil" class="form-control" type="datetime-local" />
                                            <span asp-validation-for="ValidUntil" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Botões de Ação -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-save me-2"></i>Salvar
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left me-2"></i>Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Definir data atual como padrão para ValidFrom
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const localDateTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            
            const validFromInput = document.querySelector('input[name="ValidFrom"]');
            if (validFromInput && !validFromInput.value) {
                validFromInput.value = localDateTime;
            }
            
            // Definir data de fim como padrão (30 dias a partir de hoje)
            const validUntilInput = document.querySelector('input[name="ValidUntil"]');
            if (validUntilInput && !validUntilInput.value) {
                const futureDate = new Date(now.getTime() + (30 * 24 * 60 * 60 * 1000));
                const futureDateTime = new Date(futureDate.getTime() - futureDate.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
                validUntilInput.value = futureDateTime;
            }
        });
    </script>
}
