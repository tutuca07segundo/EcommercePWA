@model IEnumerable<EcommercePWA.Models.Coupon>
@{
    ViewData["Title"] = "Cupons";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-ticket-alt me-2"></i>Cupons</h4>
                    <div>
                        <a href="@Url.Action("Index", "Admin")" class="btn btn-light me-2">
                            <i class="fas fa-arrow-left me-2"></i>Voltar ao Admin
                        </a>
                        <a class="btn btn-light" href="@Url.Action("Create")">
                            <i class="fas fa-plus me-2"></i>Novo Cupom
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhum cupom encontrado</h5>
                            <p class="text-muted">Comece criando seu primeiro cupom de desconto.</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Criar Primeiro Cupom
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Descrição</th>
                                        <th>Desconto</th>
                                        <th>Validade</th>
                                        <th>Status</th>
                                        <th>Usos</th>
                                        <th class="text-center">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><strong class="text-primary">@item.Code</strong></td>
                                            <td>@item.Description</td>
                                            <td>
                                                @if (item.DiscountAmount > 0)
                                                {
                                                    <span class="badge bg-success">R$ @item.DiscountAmount.ToString("N2")</span>
                                                }
                                                @if (item.DiscountPercentage > 0)
                                                {
                                                    <span class="badge bg-info">@item.DiscountPercentage?.ToString("N1")%</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    <div>De: @item.ValidFrom.ToString("dd/MM/yyyy")</div>
                                                    <div>Até: @item.ValidUntil.ToString("dd/MM/yyyy")</div>
                                                </small>
                                            </td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">Ativo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inativo</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    @item.CurrentUses / @(item.MaximumUses?.ToString() ?? "∞")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-outline-info btn-sm" href="@Url.Action("Details", new { id = item.Id })" title="Detalhes">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a class="btn btn-outline-warning btn-sm" href="@Url.Action("Edit", new { id = item.Id })" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Delete", new { id = item.Id })" title="Excluir">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
