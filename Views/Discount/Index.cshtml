@model List<EcommercePWA.Models.Discount>
@{
    ViewData["Title"] = "Gerenciar Descontos";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-percentage me-2 text-warning"></i>
                    Gerenciar Descontos
                </h2>
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Novo Desconto
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Nome</th>
                                        <th>Tipo</th>
                                        <th>Valor</th>
                                        <th>Período</th>
                                        <th>Status</th>
                                        <th>Produtos</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var discount in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@discount.Name</strong>
                                                @if (!string.IsNullOrEmpty(discount.Description))
                                                {
                                                    <br><small class="text-muted">@discount.Description</small>
                                                }
                                            </td>
                                            <td>
                                                @if (discount.DiscountAmount.HasValue)
                                                {
                                                    <span class="badge bg-info">Valor Fixo</span>
                                                }
                                                else if (discount.DiscountPercentage.HasValue)
                                                {
                                                    <span class="badge bg-success">Percentual</span>
                                                }
                                            </td>
                                            <td>
                                                @if (discount.DiscountAmount.HasValue)
                                                {
                                                    <span class="text-success fw-bold">R$ @discount.DiscountAmount.Value.ToString("N2")</span>
                                                }
                                                else if (discount.DiscountPercentage.HasValue)
                                                {
                                                    <span class="text-success fw-bold">@discount.DiscountPercentage.Value.ToString("N1")%</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    <strong>De:</strong> @discount.ValidFrom.ToString("dd/MM/yyyy")<br>
                                                    <strong>Até:</strong> @discount.ValidUntil.ToString("dd/MM/yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                @if (discount.IsActive && discount.ValidFrom <= DateTime.Now && discount.ValidUntil >= DateTime.Now)
                                                {
                                                    <span class="badge bg-success">Ativo</span>
                                                }
                                                else if (!discount.IsActive)
                                                {
                                                    <span class="badge bg-secondary">Inativo</span>
                                                }
                                                else if (discount.ValidFrom > DateTime.Now)
                                                {
                                                    <span class="badge bg-warning">Agendado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Expirado</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@discount.ProductDiscounts.Count produto(s)</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@discount.Id" 
                                                       class="btn btn-outline-info btn-sm" title="Ver Detalhes">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@discount.Id" 
                                                       class="btn btn-outline-primary btn-sm" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="ManageProducts" asp-route-id="@discount.Id" 
                                                       class="btn btn-outline-success btn-sm" title="Gerenciar Produtos">
                                                        <i class="fas fa-boxes"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@discount.Id" 
                                                       class="btn btn-outline-danger btn-sm" title="Excluir">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-percentage fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">Nenhum desconto cadastrado</h4>
                            <p class="text-muted">Crie seu primeiro desconto para produtos específicos.</p>
                            <a asp-action="Create" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Criar Primeiro Desconto
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
