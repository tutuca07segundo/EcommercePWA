@model List<EcommercePWA.Models.Product>
@{
    ViewData["Title"] = "Gerenciar Produtos do Desconto";
    var discountId = ViewBag.DiscountId;
    var discountName = ViewBag.DiscountName;
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-boxes me-2 text-success"></i>
                    Produtos com Desconto: @discountName
                </h2>
                <div>
                    <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#addProductModal">
                        <i class="fas fa-plus me-2"></i>Adicionar Produto
                    </button>
                    <a asp-action="Details" asp-route-id="@discountId" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Imagem</th>
                                        <th>Produto</th>
                                        <th>Marca</th>
                                        <th>Preço Original</th>
                                        <th>Categoria</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model)
                                    {
                                        <tr>
                                            <td>
                                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.jpg" : product.ImageUrl)" 
                                                     class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                                            </td>
                                            <td>
                                                <strong>@product.Name</strong>
                                                <br><small class="text-muted">@product.Description</small>
                                            </td>
                                            <td>@product.Brand</td>
                                            <td>
                                                <span class="fw-bold text-primary">R$ @product.Price.ToString("N2")</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@product.Category</span>
                                            </td>
                                            <td>
                                                <button class="btn btn-outline-danger btn-sm" 
                                                        onclick="removeProduct(@discountId, @product.Id, '@product.Name')">
                                                    <i class="fas fa-times"></i> Remover
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-boxes fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">Nenhum produto adicionado</h4>
                            <p class="text-muted">Adicione produtos para aplicar este desconto.</p>
                            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addProductModal">
                                <i class="fas fa-plus me-2"></i>Adicionar Primeiro Produto
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Adicionar Produto -->
<div class="modal fade" id="addProductModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-plus me-2"></i>Adicionar Produto ao Desconto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Selecione um produto:</label>
                    <select class="form-select" id="productSelect">
                        <option value="">Carregando produtos...</option>
                    </select>
                </div>
                <div id="productPreview" class="d-none">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <img id="previewImage" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                </div>
                                <div class="col">
                                    <h6 id="previewName" class="mb-1"></h6>
                                    <p id="previewPrice" class="mb-0 text-primary fw-bold"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="confirmAddProduct">
                    <i class="fas fa-plus me-2"></i>Adicionar Produto
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let availableProducts = [];

        document.addEventListener('DOMContentLoaded', function() {
            loadAvailableProducts();
        });

        async function loadAvailableProducts() {
            try {
                const response = await fetch(`@Url.Action("GetAvailableProducts", "Discount")?discountId=@discountId`);
                const products = await response.json();
                
                availableProducts = products;
                const select = document.getElementById('productSelect');
                select.innerHTML = '<option value="">Selecione um produto...</option>';
                
                products.forEach(product => {
                    const option = document.createElement('option');
                    option.value = product.id;
                    option.textContent = `${product.name} - R$ ${product.price}`;
                    select.appendChild(option);
                });
            } catch (error) {
                console.error('Erro ao carregar produtos:', error);
                showAlert('danger', 'Erro ao carregar produtos disponíveis');
            }
        }

        document.getElementById('productSelect').addEventListener('change', function() {
            const productId = parseInt(this.value);
            const preview = document.getElementById('productPreview');
            
            if (productId) {
                const product = availableProducts.find(p => p.id === productId);
                if (product) {
                    document.getElementById('previewName').textContent = product.name;
                    document.getElementById('previewPrice').textContent = `R$ ${product.price}`;
                    preview.classList.remove('d-none');
                }
            } else {
                preview.classList.add('d-none');
            }
        });

        document.getElementById('confirmAddProduct').addEventListener('click', async function() {
            const productId = parseInt(document.getElementById('productSelect').value);
            
            if (!productId) {
                showAlert('warning', 'Selecione um produto');
                return;
            }

            try {
                const response = await fetch('@Url.Action("AddProduct", "Discount")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `discountId=@discountId&productId=${productId}`
                });

                const result = await response.json();
                
                if (result.success) {
                    showAlert('success', result.message);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert('danger', result.message);
                }
            } catch (error) {
                console.error('Erro ao adicionar produto:', error);
                showAlert('danger', 'Erro ao adicionar produto');
            }
        });

        async function removeProduct(discountId, productId, productName) {
            if (!confirm(`Tem certeza que deseja remover "${productName}" deste desconto?`)) {
                return;
            }

            try {
                const response = await fetch('@Url.Action("RemoveProduct", "Discount")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `discountId=${discountId}&productId=${productId}`
                });

                const result = await response.json();
                
                if (result.success) {
                    showAlert('success', result.message);
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert('danger', result.message);
                }
            } catch (error) {
                console.error('Erro ao remover produto:', error);
                showAlert('danger', 'Erro ao remover produto');
            }
        }

        function showAlert(type, message) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);
            
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 5000);
        }
    </script>
}
