@model EcommercePWA.Models.ProductViewModel
@{
    ViewData["Title"] = "Kaboom - E-commerce de Periféricos e Peças";
}

<!-- Header com Barra de Pesquisa -->
<header class="bg-dark text-white py-4">
    <div class="container-fluid px-0">
        <div class="row align-items-center gx-2">
            <div class="col-md-3 d-flex align-items-center gap-2">
                <button class="btn btn-warning btn-lg ms-0" id="sidebarToggle">
                    <i class="fas fa-bars"></i> Menu
                </button>
                
                <small class="text-muted">Periféricos & Peças de Computador</small>
            </div>
            <div class="col-md-6">
                <form asp-action="Search" method="get" class="d-flex">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control form-control-lg" 
                               placeholder="Buscar produtos, marcas, categorias..." 
                               value="@Model.SearchTerm">
                        <button class="btn btn-warning btn-lg" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-md-3 text-end pe-3">
                <div class="d-flex align-items-center justify-content-end gap-2">
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-warning position-relative">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-count">
                                0
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Carrossel de Categorias em Destaque (movido para o topo) -->
<div class="container-fluid py-5 bg-light">
    <h3 class="text-center mb-4">
        <i class="fas fa-fire me-2 text-warning"></i>Categorias em Destaque
    </h3>
    <div class="row">
        <div class="col-12">
            <div class="category-carousel">
                @foreach (var category in Model.Categories.Take(6))
                {
                    <div class="category-item text-center p-3">
                        <div class="category-icon mb-3" style="color: @category.Color;">
                            <i class="@category.IconClass fa-3x"></i>
                        </div>
                        <h6 class="mb-2">@category.Name</h6>
                        <p class="text-muted small mb-3">@category.Description</p>
                        <a href="@Url.Action("Category", "Home", new { name = category.Name })" 
                           class="btn btn-outline-primary btn-sm">
                            Ver Produtos
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sidebar de Categorias -->
<div class="sidebar bg-light" id="sidebar">
    <div class="sidebar-header p-3 border-bottom">
        <h5 class="mb-0">
            <i class="fas fa-th-large me-2"></i>Categorias
        </h5>
        <button type="button" class="btn-close" id="sidebarClose"></button>
    </div>
    <div class="sidebar-body p-0">
        <div class="list-group list-group-flush">
            <a href="@Url.Action("Index", "Home")" 
               class="list-group-item list-group-item-action @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">
                <i class="fas fa-home me-2"></i>Todas as Categorias
            </a>
            @foreach (var category in Model.Categories.OrderBy(c => c.DisplayOrder))
            {
                <a href="@Url.Action("Category", "Home", new { name = category.Name })" 
                   class="list-group-item list-group-item-action @(Model.SelectedCategory == category.Name ? "active" : "")">
                    <i class="@category.IconClass me-2" style="color: @category.Color;"></i>
                    @category.Name
                    <small class="text-muted d-block">@category.Description</small>
                </a>
            }
        </div>
    </div>
</div>

<!-- Overlay para fechar sidebar -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Conteúdo Principal -->
<main class="main-content">
    <div class="container-fluid py-4">
        <!-- Painel de Filtros Avançados -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="fas fa-filter me-2"></i>Filtros Avançados
                            </h6>
                            <button class="btn btn-outline-primary btn-sm" type="button" id="toggleFilters">
                                <i class="fas fa-chevron-down me-1"></i>Expandir Filtros
                            </button>
                        </div>
                    </div>
                    <div class="card-body" id="filtersPanel" style="display: none;">
                        <form id="advancedFiltersForm">
                            <div class="row g-3">
                                <!-- Busca com Autocomplete -->
                                <div class="col-md-4">
                                    <label class="form-label">Buscar Produtos</label>
                                    <div class="position-relative">
                                        <input type="text" class="form-control" id="searchInput" 
                                               placeholder="Digite para buscar..." autocomplete="off">
                                        <div id="searchSuggestions" class="position-absolute w-100 bg-white border rounded shadow-sm" 
                                             style="top: 100%; z-index: 1000; display: none; max-height: 300px; overflow-y: auto;"></div>
                                    </div>
                                </div>

                                <!-- Categorias -->
                                <div class="col-md-4">
                                    <label class="form-label">Categorias</label>
                                    <div id="categoryFilters" class="filter-checkboxes">
                                        <!-- Preenchido dinamicamente -->
                                    </div>
                                </div>

                                <!-- Marcas -->
                                <div class="col-md-4">
                                    <label class="form-label">Marcas</label>
                                    <div id="brandFilters" class="filter-checkboxes">
                                        <!-- Preenchido dinamicamente -->
                                    </div>
                                </div>

                                <!-- Faixa de Preço -->
                                <div class="col-md-6">
                                    <label class="form-label">Faixa de Preço</label>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="number" class="form-control" id="minPrice" 
                                                   placeholder="Preço mínimo" min="0" step="0.01">
                                        </div>
                                        <div class="col-6">
                                            <input type="number" class="form-control" id="maxPrice" 
                                                   placeholder="Preço máximo" min="0" step="0.01">
                                        </div>
                                    </div>
                                </div>

                                <!-- Avaliação Mínima -->
                                <div class="col-md-3">
                                    <label class="form-label">Avaliação Mínima</label>
                                    <select class="form-select" id="minRating">
                                        <option value="">Qualquer avaliação</option>
                                        <option value="1">⭐ 1+ estrelas</option>
                                        <option value="2">⭐⭐ 2+ estrelas</option>
                                        <option value="3">⭐⭐⭐ 3+ estrelas</option>
                                        <option value="4">⭐⭐⭐⭐ 4+ estrelas</option>
                                        <option value="5">⭐⭐⭐⭐⭐ 5 estrelas</option>
                                    </select>
                                </div>

                                <!-- Filtros Adicionais -->
                                <div class="col-md-3">
                                    <label class="form-label">Filtros Extras</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="inStockOnly">
                                        <label class="form-check-label" for="inStockOnly">
                                            Apenas em estoque
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="onSaleOnly">
                                        <label class="form-check-label" for="onSaleOnly">
                                            Apenas em promoção
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Ordenação -->
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label class="form-label">Ordenar por</label>
                                    <select class="form-select" id="sortBy">
                                        <option value="name">Nome (A-Z)</option>
                                        <option value="price">Menor Preço</option>
                                        <option value="price-desc">Maior Preço</option>
                                        <option value="rating">Melhor Avaliação</option>
                                        <option value="newest">Mais Recentes</option>
                                    </select>
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <button type="button" class="btn btn-warning me-2" id="applyFilters">
                                        <i class="fas fa-search me-1"></i>Aplicar Filtros
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" id="clearFilters">
                                        <i class="fas fa-times me-1"></i>Limpar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros Ativos -->
        <div class="row mb-3" id="activeFiltersRow" style="display: none;">
            <div class="col-12">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="text-muted me-2">Filtros ativos:</span>
                    <div id="activeFiltersBadges" class="d-flex flex-wrap gap-1">
                        <!-- Badges de filtros ativos -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Resultados da Busca -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-boxes me-2"></i>
                        <span id="resultsTitle">Todos os Produtos</span>
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <div id="loadingSpinner" class="spinner-border spinner-border-sm text-warning" style="display: none;" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <span class="text-muted" id="resultsCount">@Model.Products.Count produto(s) encontrado(s)</span>
                        @if (Context.Session.GetInt32("UserId").HasValue)
                        {
                            <a href="@Url.Action("Create", "Product")" class="btn btn-success btn-sm">
                                <i class="fas fa-plus me-1"></i>Novo Produto
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid de Produtos -->
        <div id="productsContainer">
            @if (Model.Products.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4" id="productsGrid">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col">
                            <div class="card h-100 product-card position-relative" style="cursor: pointer;" onclick="navigateToProduct(@product.Id, event)">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.jpg" : product.ImageUrl)" 
                                     class="card-img-top" alt="@product.Name" 
                                     style="height: 200px; object-fit: cover;">
                                <div class="position-absolute top-0 start-0 m-2">
                                    @if (product.StockQuantity <= 5 && product.StockQuantity > 0)
                                    {
                                        <span class="badge bg-warning">Últimas unidades</span>
                                    }
                                    else if (product.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">Indisponível</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Em estoque</span>
                                    }
                                </div>
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-primary">@product.Type</span>
                                </div>
                                @if (Context.Session.GetInt32("UserId").HasValue)
                                {
                                    <button class="btn btn-light position-absolute wishlist-btn" 
                                            style="bottom: 10px; right: 10px; border-radius: 50%; width: 45px; height: 45px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); display: flex; align-items: center; justify-content: center; border: 1px solid #e0e0e0;"
                                            data-product-id="@product.Id"
                                            onclick="toggleWishlist(@product.Id, null, this); event.stopPropagation();"
                                            title="Adicionar aos favoritos">
                                        <i class="fas fa-heart text-muted" style="font-size: 16px;"></i>
                                    </button>
                                }
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <small class="text-muted">@product.Brand</small>
                                </div>
                                <h6 class="card-title text-dark">
                                    @product.Name
                                </h6>
                                <p class="card-text text-muted small flex-grow-1">@Html.Raw(product.Description)</p>
                                
                                <div class="mb-2">
                                    <div class="d-flex align-items-center mb-1">
                                        <div class="text-warning me-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= product.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else if (i - 0.5m <= product.Rating)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>
                                        <small class="text-muted">(@product.ReviewCount)</small>
                                    </div>
                                </div>

                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            @if (product.HasDiscount && product.DiscountedPrice.HasValue)
                                            {
                                                <div>
                                                    <span class="h6 text-muted text-decoration-line-through mb-0">R$ @product.Price.ToString("N2")</span>
                                                    <span class="h5 text-danger mb-0 ms-2">R$ @product.DiscountedPrice.Value.ToString("N2")</span>
                                                    <span class="badge bg-danger ms-1">
                                                        @{
                                                            var discountPercent = Math.Round((1 - (product.DiscountedPrice.Value / product.Price)) * 100, 0);
                                                        }
                                                        -@(discountPercent)%
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="h5 text-primary mb-0">R$ @product.Price.ToString("N2")</span>
                                            }
                                        </div>
                                        <small class="text-muted">@product.StockQuantity em estoque</small>
                                    </div>
                                    
                                    <div class="d-grid gap-2">
                                        @if (Context.Session.GetInt32("UserId").HasValue)
                                        {
                                            <button class="btn btn-warning btn-sm" data-product-id="@product.Id" onclick="addToCart(this); event.stopPropagation();">
                                                <i class="fas fa-shopping-cart me-1"></i>Adicionar ao Carrinho
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-warning btn-sm" onclick="redirectToLogin(); event.stopPropagation();">
                                                <i class="fas fa-sign-in-alt me-1"></i>Fazer Login para Comprar
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5" id="noResultsMessage">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">Nenhum produto encontrado</h4>
                <p class="text-muted">Tente ajustar os filtros ou fazer uma nova busca.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-warning">
                    <i class="fas fa-home me-1"></i>Ver Todos os Produtos
                </a>
            </div>
        }
    </div>

    <!-- Paginação -->
    <div class="row mt-4" id="paginationContainer" style="display: none;">
        <div class="col-12">
            <nav aria-label="Navegação de páginas">
                <ul class="pagination justify-content-center" id="paginationList">
                    <!-- Paginação dinâmica -->
                </ul>
            </nav>
        </div>
    </div>
</div>
</main>

@section Scripts {
    <script src="~/js/advanced-filters.js"></script>
    <script>
         function addToCartFromHome(productId) {
                @if (!Context.Session.GetInt32("UserId").HasValue)
                {
                    <text>
                    const returnUrl = window.location.pathname + window.location.search;
                    window.location.href = '@Url.Action("Login", "Auth")?mustLoginToBuy=1&returnUrl=' + encodeURIComponent(returnUrl);
                    return;
                    </text>
                }
                // Se logado, segue fluxo normal
                const data = {
                    productId: productId,
                    variationId: null,
                    quantity: 1
                };

                fetch('@Url.Action("AddToCart", "Cart")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateCartCount(data.cartItemCount);
                        showAlert('success', 'Produto adicionado ao carrinho!');
                    } else {
                        if (data.requireLogin) {
                            const returnUrl = window.location.pathname + window.location.search;
                            window.location.href = '@Url.Action("Login", "Auth")?mustLoginToBuy=1&returnUrl=' + encodeURIComponent(returnUrl);
                        } else {
                            showAlert('danger', data.message);
                        }
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    showAlert('danger', 'Erro de conexão ao adicionar ao carrinho');
                });
            }

             function updateCartCount(count) {
                const cartCountElement = document.querySelector('.cart-count');
                if (cartCountElement) {
                    cartCountElement.textContent = count;
                }
            }

            function showAlert(type, message) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
                alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);
                
                // Auto-remover após 5 segundos
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            }

            function redirectToLogin() {
                const returnUrl = window.location.pathname + window.location.search;
                window.location.href = '@Url.Action("Login", "Auth")?mustLoginToBuy=1&returnUrl=' + encodeURIComponent(returnUrl);
            }

            function navigateToProduct(productId, event) {
                // Verifica se o clique foi em um botão ou elemento interativo
                if (event.target.closest('button') || event.target.closest('a')) {
                    return; // Não navega se clicou em um botão
                }
                
                // Navega para a página de detalhes do produto
                window.location.href = '@Url.Action("Details", "Product")?id=' + productId;
            }

        // Funcionalidade da Sidebar
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebarClose = document.getElementById('sidebarClose');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const mainContent = document.querySelector('.main-content');

            function openSidebar() {
                sidebar.classList.add('active');
                sidebarOverlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('active');
                sidebarOverlay.classList.remove('active');
                document.body.style.overflow = '';
            }

            sidebarToggle.addEventListener('click', openSidebar);
            sidebarClose.addEventListener('click', closeSidebar);
            sidebarOverlay.addEventListener('click', closeSidebar);

            // Fechar sidebar ao redimensionar
            window.addEventListener('resize', function() {
                if (window.innerWidth > 768) {
                    closeSidebar();
                }
            });

            // Funcionalidade do carrossel de categorias
            const categoryCarousel = document.querySelector('.category-carousel');


            if (categoryCarousel) {
                let isDown = false;
                let startX;
                let scrollLeft;

                categoryCarousel.addEventListener('mousedown', (e) => {
                    isDown = true;
                    categoryCarousel.classList.add('active');
                    startX = e.pageX - categoryCarousel.offsetLeft;
                    scrollLeft = categoryCarousel.scrollLeft;
                });

                categoryCarousel.addEventListener('mouseleave', () => {
                    isDown = false;
                    categoryCarousel.classList.remove('active');
                });

                categoryCarousel.addEventListener('mouseup', () => {
                    isDown = false;
                    categoryCarousel.classList.remove('active');
                });

                categoryCarousel.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - categoryCarousel.offsetLeft;
                    const walk = (x - startX) * 2;
                    categoryCarousel.scrollLeft = scrollLeft - walk;
                });
            }
        });
    </script>
}
