@model EcommercePWA.Models.Order
@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="fas fa-receipt me-2"></i>Pedido #@Model.Id - @Model.OrderNumber</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex justify-content-between align-items-center">
                            <span>@TempData["SuccessMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger d-flex justify-content-between align-items-center">
                            <span>@TempData["ErrorMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Cliente</h5>
                            <p class="mb-1"><strong>@Model.User?.Name</strong></p>
                            <p class="text-muted">@Model.User?.Email</p>

                            <h5 class="text-primary mb-3">Envio</h5>
                            <p class="mb-0">@Model.ShippingAddress</p>
                            <small class="text-muted">@Model.ShippingCity - @Model.ShippingZipCode - @Model.ShippingCountry</small>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Status</h5>
                            <p>
                                <span class="badge bg-secondary">Pagamento: @Model.PaymentStatus</span>
                                @switch (Model.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning ms-2">Pendente</span>
                                        break;
                                    case "Processing":
                                        <span class="badge bg-info ms-2">Processando</span>
                                        break;
                                    case "Shipped":
                                        <span class="badge bg-primary ms-2">A caminho</span>
                                        break;
                                    case "Delivered":
                                        <span class="badge bg-success ms-2">Entregue</span>
                                        break;
                                }
                            </p>
                            <p class="mb-1">Pedido: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                            @if (Model.ShippedDate.HasValue)
                            {
                                <p class="mb-1">Envio: @Model.ShippedDate.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            }
                            @if (Model.DeliveredDate.HasValue)
                            {
                                <p class="mb-1">Entrega: @Model.DeliveredDate.Value.ToString("dd/MM/yyyy HH:mm")</p>
                            }
                            
                            <h5 class="text-primary mb-3 mt-4">Pagamento</h5>
                            <p class="mb-1"><strong>Método:</strong> 
                                @switch (Model.PaymentMethod)
                                {
                                    case "credit_card":
                                        <span>Cartão de Crédito</span>
                                        break;
                                    case "debit_card":
                                        <span>Cartão de Débito</span>
                                        break;
                                    case "pix":
                                        <span>PIX</span>
                                        break;
                                    case "boleto":
                                        <span>Boleto Bancário</span>
                                        break;
                                    default:
                                        <span>@Model.PaymentMethod</span>
                                        break;
                                }
                            </p>
                        </div>
                    </div>

                    <hr>

                    <h5 class="text-primary mb-3">Itens</h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th>Variação</th>
                                    <th>Qtd</th>
                                    <th>Preço</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.VariationName</td>
                                        <td>@item.Quantity</td>
                                        <td>R$ @item.UnitPrice.ToString("N2")</td>
                                        <td>R$ @(item.UnitPrice * item.Quantity).ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <hr>
                    
                    <!-- Resumo Financeiro -->
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">Resumo Financeiro</h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal:</span>
                                        <span>R$ @Model.Subtotal.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Frete:</span>
                                        <span>R$ @Model.ShippingCost.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Impostos:</span>
                                        <span>R$ @Model.TaxAmount.ToString("N2")</span>
                                    </div>
                                    @if (Model.DiscountAmount > 0)
                                    {
                                        <div class="d-flex justify-content-between mb-2 text-success">
                                            <span>Desconto:</span>
                                            <span>-R$ @Model.DiscountAmount.ToString("N2")</span>
                                        </div>
                                    }
                                    <hr>
                                    <div class="d-flex justify-content-between">
                                        <strong>Total:</strong>
                                        <strong class="text-success">R$ @Model.Total.ToString("N2")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-4">
                            <h5 class="text-primary mb-3">Observações</h5>
                            <div class="alert alert-info">
                                @Model.Notes
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a href="@Url.Action("Orders", "Admin")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Voltar
                        </a>
                        <div>
                            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-2"></i>Editar
                            </a>
                            @if (Model.Status != "Delivered" && Model.Status != "Cancelled")
                            {
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown">
                                        <i class="fas fa-cog me-2"></i>Processar
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (Model.PaymentStatus == "Pending")
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("Process", new { id = Model.Id, status = "Processing" })">
                                                <i class="fas fa-check me-2"></i>Confirmar Pagamento
                                            </a></li>
                                        }
                                        @if (Model.Status == "Processing")
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("Process", new { id = Model.Id, status = "Shipped" })">
                                                <i class="fas fa-shipping-fast me-2"></i>Marcar como Enviado
                                            </a></li>
                                        }
                                        @if (Model.Status == "Shipped")
                                        {
                                            <li><a class="dropdown-item" href="@Url.Action("Process", new { id = Model.Id, status = "Delivered" })">
                                                <i class="fas fa-check-circle me-2"></i>Marcar como Entregue
                                            </a></li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="@Url.Action("Process", new { id = Model.Id, status = "Cancelled" })">
                                            <i class="fas fa-times me-2"></i>Cancelar Pedido
                                        </a></li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


