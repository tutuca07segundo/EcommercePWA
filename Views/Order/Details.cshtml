@model EcommercePWA.Models.Order
@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="fas fa-receipt me-2"></i>Pedido #@Model.Id - @Model.OrderNumber</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex justify-content-between align-items-center">
                            <span>@TempData["SuccessMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger d-flex justify-content-between align-items-center">
                            <span>@TempData["ErrorMessage"]</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Cliente</h5>
                            <p class="mb-1"><strong>@Model.User?.Name</strong></p>
                            <p class="text-muted">@Model.User?.Email</p>

                            <h5 class="text-primary mb-3">Envio</h5>
                            <p class="mb-0">@Model.ShippingAddress</p>
                            <small class="text-muted">@Model.ShippingCity - @Model.ShippingZipCode - @Model.ShippingCountry</small>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Status</h5>
                            <p>
                                <span class="badge bg-secondary">Pagamento: @Model.PaymentStatus</span>
                                @switch (Model.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning ms-2">Pendente</span>
                                        break;
                                    case "Processing":
                                        <span class="badge bg-info ms-2">Processando</span>
                                        break;
                                    case "Shipped":
                                        <span class="badge bg-primary ms-2">A caminho</span>
                                        break;
                                    case "Delivered":
                                        <span class="badge bg-success ms-2">Entregue</span>
                                        break;
                                }
                            </p>
                            <p class="mb-1">Pedido: @Model.OrderDate:dd/MM/yyyy HH:mm</p>
                            @if (Model.ShippedDate.HasValue)
                            {
                                <p class="mb-1">Envio: @Model.ShippedDate:dd/MM/yyyy HH:mm</p>
                            }
                            @if (Model.DeliveredDate.HasValue)
                            {
                                <p class="mb-1">Entrega: @Model.DeliveredDate:dd/MM/yyyy HH:mm</p>
                            }
                        </div>
                    </div>

                    <hr>

                    <h5 class="text-primary mb-3">Itens</h5>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th>Variação</th>
                                    <th>Qtd</th>
                                    <th>Preço</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.VariationName</td>
                                        <td>@item.Quantity</td>
                                        <td>R$ @item.UnitPrice.ToString("N2")</td>
                                        <td>R$ @(item.UnitPrice * item.Quantity).ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Orders", "Admin")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Voltar
                        </a>
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i>Editar Status
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


