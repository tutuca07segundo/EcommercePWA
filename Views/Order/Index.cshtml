@model IEnumerable<EcommercePWA.Models.TopProductReportItem>
@{
    ViewData["Title"] = "Relatórios de Vendas";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-warning">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Produtos Mais Vendidos</h4>
                        <p class="mb-0 opacity-75">Ranking por quantidade de vendas</p>
                    </div>
                    <a href="@Url.Action("Orders", "Admin")" class="btn btn-light">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted py-5">Nenhuma venda registrada.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Produto</th>
                                        <th>Vendas</th>
                                        <th>Receita</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var i = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.ProductName</td>
                                            <td><strong>@item.TotalQuantity</strong></td>
                                            <td>R$ @item.TotalRevenue.ToString("N2")</td>
                                        </tr>
                                        i++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


