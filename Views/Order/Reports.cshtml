@model IEnumerable<EcommercePWA.Models.TopProductReportItem>
@{
    ViewData["Title"] = "Relatórios de Vendas";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="fas fa-chart-bar me-2"></i>
                                Relatórios de Vendas
                            </h4>
                            <p class="mb-0 opacity-75">Produtos mais vendidos e estatísticas</p>
                        </div>
                        <div>
                            <a href="@Url.Action("Orders", "Admin")" class="btn btn-light">
                                <i class="fas fa-arrow-left me-2"></i>Voltar aos Pedidos
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Produtos Mais Vendidos -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-trophy me-2 text-warning"></i>
                        Produtos Mais Vendidos
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th width="50">#</th>
                                        <th>Produto</th>
                                        <th width="150" class="text-center">Quantidade Vendida</th>
                                        <th width="150" class="text-end">Receita Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var position = 1;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (position <= 3)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        @if (position == 1) { <i class="fas fa-trophy"></i> }
                                                        else if (position == 2) { <i class="fas fa-medal"></i> }
                                                        else { <i class="fas fa-award"></i> }
                                                        @position°
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@position°</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@item.ProductName</strong>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary fs-6">
                                                    @item.TotalQuantity vendido@(item.TotalQuantity > 1 ? "s" : "")
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <strong class="text-success">@item.TotalRevenue.ToString("C")</strong>
                                            </td>
                                        </tr>
                                        position++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-bar fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhum dado de vendas encontrado</h5>
                            <p class="text-muted">Ainda não há pedidos finalizados para gerar relatórios.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Estatísticas Resumidas -->
    @if (Model != null && Model.Any())
    {
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body text-center">
                        <i class="fas fa-box fa-2x mb-2"></i>
                        <h4>@Model.Count()</h4>
                        <p class="mb-0">Produtos Vendidos</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center">
                        <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                        <h4>@Model.Sum(x => x.TotalQuantity)</h4>
                        <p class="mb-0">Total de Itens</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body text-center">
                        <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                        <h4>@Model.Sum(x => x.TotalRevenue).ToString("C")</h4>
                        <p class="mb-0">Receita Total</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark">
                    <div class="card-body text-center">
                        <i class="fas fa-star fa-2x mb-2"></i>
                        <h4>@(Model.Any() ? Model.First().ProductName : "N/A")</h4>
                        <p class="mb-0">Mais Vendido</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
