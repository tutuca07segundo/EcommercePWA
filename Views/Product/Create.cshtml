@model EcommercePWA.Models.Product
@{
    ViewData["Title"] = "Criar Novo Produto";
}

@if (Context.Session.GetString("UserRole") != "Admin")
{
    <div class="alert alert-danger mt-4">Acesso restrito: apenas administradores podem criar produtos.</div>
    return;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Criar Novo Produto
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Nome do Produto *</label>
                            <input asp-for="Name" class="form-control" placeholder="Ex: Mouse Gaming Logitech G Pro X" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descrição *</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Descreva as características do produto..." autocomplete="off"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="Category" class="form-label">Categoria *</label>
                                    <select asp-for="Category" class="form-select" id="Category" autocomplete="off">
                                        <option value="">Selecione uma categoria</option>
                                        @foreach (var category in ViewBag.Categories)
                                        {
                                            <option value="@category.Name" data-category-id="@category.Id">@category.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Brand" class="form-label">Marca *</label>
                                    <select asp-for="Brand" class="form-select" id="BrandSelect" disabled autocomplete="off">
                                        <option value="">Primeiro selecione uma categoria</option>
                                    </select>
                                    <span asp-validation-for="Brand" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Type" class="form-label">Tipo *</label>
                                    <select asp-for="Type" class="form-select" autocomplete="off">
                                        <option value="">Selecione o tipo</option>
                                        <option value="Periférico">Periférico</option>
                                        <option value="Peça">Peça</option>
                                        <option value="Acessório">Acessório</option>
                                    </select>
                                    <span asp-validation-for="Type" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="StockQuantity" class="form-label">Quantidade em Estoque *</label>
                                    <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="0" autocomplete="off" />
                                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Price" class="form-label">Preço (R$) *</label>
                                    <div class="input-group">
                                        <span class="input-group-text">R$</span>
                                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" autocomplete="off" />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ImageUrl" class="form-label">URL da Imagem</label>
                                    <input asp-for="ImageUrl" class="form-control" placeholder="https://exemplo.com/imagem.jpg" autocomplete="url" />
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                    <small class="form-text text-muted">Deixe em branco para usar imagem padrão</small>
                                </div>
                            </div>
                        </div>

                        <!-- Campos de Peso e Dimensões para Frete -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0"><i class="fas fa-shipping-fast me-2"></i>Informações para Cálculo de Frete</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label asp-for="Weight" class="form-label">Peso (gramas) *</label>
                                            <div class="input-group">
                                                <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0.01" max="50000" placeholder="500" autocomplete="off" />
                                                <span class="input-group-text">g</span>
                                            </div>
                                            <span asp-validation-for="Weight" class="text-danger"></span>
                                            <small class="form-text text-muted">Peso em gramas (máx: 50kg)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label asp-for="Width" class="form-label">Largura (cm) *</label>
                                            <div class="input-group">
                                                <input asp-for="Width" class="form-control" type="number" min="1" max="200" placeholder="20" autocomplete="off" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Width" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label asp-for="Height" class="form-label">Altura (cm) *</label>
                                            <div class="input-group">
                                                <input asp-for="Height" class="form-control" type="number" min="1" max="200" placeholder="15" autocomplete="off" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Height" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            <label asp-for="Length" class="form-label">Comprimento (cm) *</label>
                                            <div class="input-group">
                                                <input asp-for="Length" class="form-control" type="number" min="1" max="200" placeholder="25" autocomplete="off" />
                                                <span class="input-group-text">cm</span>
                                            </div>
                                            <span asp-validation-for="Length" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="alert alert-info mb-0">
                                    <small><i class="fas fa-info-circle me-1"></i>
                                    Essas informações são usadas para calcular o frete real via Melhor Envio. 
                                    Produtos sem dimensões usarão valores padrão.</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tags" class="form-label">Tags</label>
                            <input asp-for="Tags" class="form-control" placeholder="gaming, wireless, leve (separadas por vírgula)" autocomplete="off" />
                            <span asp-validation-for="Tags" class="text-danger"></span>
                            <small class="form-text text-muted">Separe as tags por vírgula</small>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Products", "Admin")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Voltar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-2"></i>Criar Produto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-2">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-info">
                Após criar o produto, você poderá adicionar variações (cores e preços) na tela de edição.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        // Converter string de tags para array e vice-versa
        document.addEventListener('DOMContentLoaded', function() {
            const tagsInput = document.querySelector('input[name="Tags"]');
            const categorySelect = document.getElementById('Category');
            const subcategorySelect = document.getElementById('SubcategoryId');
            
            // Converter array para string ao carregar
            if (tagsInput.value && tagsInput.value.startsWith('[')) {
                try {
                    const tags = JSON.parse(tagsInput.value);
                    tagsInput.value = tags.join(', ');
                } catch (e) {
                    console.log('Tags já estão em formato string');
                }
            }

            const brandSelect = document.getElementById('BrandSelect');
            
            // Carregar marcas quando categoria for selecionada
            categorySelect.addEventListener('change', function() {
                const categoryName = this.value;
                
                if (categoryName) {
                    // Habilitar select de marca
                    brandSelect.disabled = false;
                    brandSelect.innerHTML = '<option value="">Carregando...</option>';
                    
                    // Buscar marcas da categoria via AJAX
                    fetch(`/Product/GetBrandsByCategory?category=${encodeURIComponent(categoryName)}`)
                        .then(response => response.json())
                        .then(data => {
                            brandSelect.innerHTML = '<option value="">Selecione uma marca</option>';
                            data.forEach(brand => {
                                const option = document.createElement('option');
                                option.value = brand;
                                option.textContent = brand;
                                brandSelect.appendChild(option);
                            });
                            // Adicionar opção "Outra"
                            const otherOption = document.createElement('option');
                            otherOption.value = 'other';
                            otherOption.textContent = '+ Adicionar nova marca';
                            brandSelect.appendChild(otherOption);
                        })
                        .catch(error => {
                            console.error('Erro ao carregar marcas:', error);
                            brandSelect.innerHTML = '<option value="">Erro ao carregar marcas</option>';
                        });
                } else {
                    // Desabilitar select de marca
                    brandSelect.disabled = true;
                    brandSelect.innerHTML = '<option value="">Primeiro selecione uma categoria</option>';
                }
            });
            
            // Permitir adicionar nova marca
            brandSelect.addEventListener('change', function() {
                if (this.value === 'other') {
                    const newBrand = prompt('Digite o nome da nova marca:');
                    if (newBrand && newBrand.trim()) {
                        const option = document.createElement('option');
                        option.value = newBrand.trim();
                        option.textContent = newBrand.trim();
                        option.selected = true;
                        // Inserir antes da opção "Outra"
                        this.insertBefore(option, this.lastElementChild);
                    } else {
                        this.value = '';
                    }
                }
            });
        });
    </script>
}
