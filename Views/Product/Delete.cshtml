@model EcommercePWA.Models.Product
@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Exclusão
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>Atenção!
                        </h5>
                        <p class="mb-0">Esta ação não pode ser desfeita. O produto será removido permanentemente do sistema.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.jpg" : Model.ImageUrl)" 
                                 class="img-fluid rounded" alt="@Model.Name" style="max-height: 200px;">
                        </div>
                        <div class="col-md-8">
                            <h5>@Model.Name</h5>
                            <p class="text-muted">@Model.Description</p>
                            
                            <div class="row">
                                <div class="col-6">
                                    <strong>Marca:</strong><br>
                                    <span class="text-muted">@Model.Brand</span>
                                </div>
                                <div class="col-6">
                                    <strong>Categoria:</strong><br>
                                    <span class="text-muted">@Model.Category</span>
                                </div>
                            </div>
                            
                            <div class="row mt-2">
                                <div class="col-6">
                                    <strong>Preço:</strong><br>
                                    <span class="text-primary h5">R$ @Model.Price.ToString("N2")</span>
                                </div>
                                <div class="col-6">
                                    <strong>Estoque:</strong><br>
                                    <span class="text-muted">@Model.StockQuantity unidades</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Details", "Product", new { id = Model.Id })" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </a>
                        <form asp-action="Delete" method="post" style="display: inline;">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza que deseja excluir este produto?')">
                                <i class="fas fa-trash me-2"></i>Confirmar Exclusão
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
