@model EcommercePWA.Models.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Category", "Product", new { name = Model.Product.Category })">@Model.Product.Category</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
        </ol>
    </nav>

    <!-- Banner Promocional -->
    <div class="alert alert-warning text-center mb-4" role="alert">
        <i class="fas fa-fire me-2"></i>
        <strong>QUINZENA GAMER</strong> - Descontos especiais em produtos gaming!
    </div>

    <div class="row">
        <!-- Galeria de Imagens -->
        <div class="col-lg-6 mb-4">
            <div class="product-gallery">
                <!-- Imagem Principal -->
                <div class="main-image-container mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/placeholder.jpg" : Model.Product.ImageUrl)" 
                         class="img-fluid rounded" id="mainImage" alt="@Model.Product.Name">
                </div>
                
                <!-- Miniaturas -->
                <div class="thumbnails-container">
                    <div class="d-flex gap-2 overflow-auto">
                        <div class="thumbnail-item active" onclick="changeMainImage(this, '@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/placeholder.jpg" : Model.Product.ImageUrl)')">
                            <img src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/placeholder.jpg" : Model.Product.ImageUrl)" 
                                 class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;">
                        </div>
                        @if (Model.Variations != null && Model.Variations.Any())
                        {
                            foreach (var variation in Model.Variations.Take(4))
                            {
                                if (!string.IsNullOrEmpty(variation.ImageUrl))
                                {
                                    <div class="thumbnail-item" onclick="changeMainImage(this, '@variation.ImageUrl')">
                                        <img src="@variation.ImageUrl" class="img-thumbnail" 
                                             style="width: 80px; height: 80px; object-fit: cover;">
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Informações do Produto -->
        <div class="col-lg-6">
            <div class="product-info">
                <!-- Marca e Avaliação -->
                <div class="mb-3">
                    <span class="badge bg-secondary me-2">@Model.Product.Brand</span>
                    <div class="d-inline-block">
                        <div class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.Product.Rating)
                                {
                                    <i class="fas fa-star"></i>
                                }
                                else if (i - 0.5m <= Model.Product.Rating)
                                {
                                    <i class="fas fa-star-half-alt"></i>
                                }
                                else
                                {
                                    <i class="far fa-star"></i>
                                }
                            }
                        </div>
                        <small class="text-muted">(@Model.Product.ReviewCount avaliações)</small>
                    </div>
                </div>

                <!-- Nome do Produto -->
                <h1 class="h3 mb-3">@Model.Product.Name</h1>

                <!-- Vendido por -->
                <p class="text-muted mb-3">
                    Vendido e entregue por 
                    <span class="text-warning fw-bold">Kaboom!</span>
                </p>

                <!-- Sobre o Produto -->
                <div class="mb-4">
                    <h6 class="d-flex align-items-center mb-2">
                        <i class="fas fa-exclamation-circle text-warning me-2"></i>
                        SOBRE O PRODUTO
                        <span class="badge bg-primary ms-2">
                            <i class="fas fa-star me-1"></i>RESUMO DE PRODUTO 
                        </span>
                    </h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-microchip text-primary me-2"></i>
                            <strong>Sistema e Performance:</strong> @Model.Product.Description
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-tv text-success me-2"></i>
                            <strong>Display e Visualização:</strong> Gráficos 4K para mundos vibrantes e jogabilidade fluida
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-headphones text-info me-2"></i>
                            <strong>Áudio:</strong> Tecnologia de Áudio 3D para imersão sonora completa
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-gamepad text-warning me-2"></i>
                            <strong>Jogos Incluídos:</strong> ASTRO BOT e Gran Turismo 7 inclusos
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-download text-secondary me-2"></i>
                            <strong>Biblioteca:</strong> Compatível com milhares de jogos de PS4
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Seção de Compra -->
    <div class="row mt-4">
        <div class="col-lg-8">
            <!-- Variações do Produto -->
            @if (Model.Variations != null && Model.Variations.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-palette me-2"></i>Variações Disponíveis
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var variation in Model.Variations.Where(v => v.IsAvailable))
                            {
                                <div class="variation-item">
                                    <input type="radio" class="btn-check" name="variationId" 
                                           id="variation_@variation.Id" value="@variation.Id" 
                                           data-modifier="@(variation.PriceModifier?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
                                           @(variation.Id == Model.Variations.First().Id ? "checked" : "")>
                                    <label class="btn btn-outline-primary" for="variation_@variation.Id">
                                        @variation.Name
                                        @if (!string.IsNullOrEmpty(variation.ColorHex))
                                        {
                                            <span class="ms-2 align-middle" style="display:inline-block;width:12px;height:12px;border-radius:50%;background:@variation.ColorHex;border:1px solid #ccc"></span>
                                        }
                                        @if (variation.PriceModifier.HasValue && variation.PriceModifier != 0)
                                        {
                                            <small class="d-block">@(variation.PriceModifier > 0 ? "+" : "")@variation.PriceModifier.Value.ToString("N2")</small>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Avaliações -->
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-star me-2"></i>Avaliações dos Clientes
                        </h6>
                    </div>
                    <div class="card-body">
                        @foreach (var review in Model.Reviews.Take(5))
                        {
                            <div class="review-item border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="text-warning">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                                <h6 class="mb-1">@review.Title</h6>
                                <p class="mb-0 text-muted">@review.Comment</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Produtos Relacionados -->
            @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-thumbs-up me-2"></i>Produtos Relacionados
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var relatedProduct in Model.RelatedProducts.Take(4))
                            {
                                <div class="col-md-6 col-lg-3 mb-3">
                                    <div class="card h-100">
                                        <img src="@(string.IsNullOrEmpty(relatedProduct.ImageUrl) ? "/images/placeholder.jpg" : relatedProduct.ImageUrl)" 
                                             class="card-img-top" style="height: 120px; object-fit: cover;">
                                        <div class="card-body">
                                            <h6 class="card-title">@relatedProduct.Name</h6>
                                            @if (relatedProduct.HasDiscount && relatedProduct.DiscountedPrice.HasValue)
                                            {
                                                <div>
                                                    <span class="text-muted text-decoration-line-through small">R$ @relatedProduct.Price.ToString("N2")</span>
                                                    <p class="text-danger fw-bold mb-1">R$ @relatedProduct.DiscountedPrice.Value.ToString("N2")</p>
                                                    @{
                                                        var relatedDiscountPercent = Math.Round((1 - (relatedProduct.DiscountedPrice.Value / relatedProduct.Price)) * 100, 0);
                                                    }
                                                    <span class="badge bg-danger small">-@(relatedDiscountPercent)%</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-primary fw-bold">R$ @relatedProduct.Price.ToString("N2")</p>
                                            }
                                            <a href="@Url.Action("Details", "Product", new { id = relatedProduct.Id })" 
                                               class="btn btn-outline-warning btn-sm">Ver Detalhes</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Card de Compra -->
        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-body">
                    <!-- Selo -->
                    <div class="text-center mb-3">
                        <span class="badge bg-primary fs-6">CAMPEÃO DE VENDAS</span>
                    </div>

                    <!-- Preços -->
                    <div class="text-center mb-3">
                        @if (Model.Product.HasDiscount && Model.Product.DiscountedPrice.HasValue)
                        {
                            var discountPercent = Math.Round((1 - (Model.Product.DiscountedPrice.Value / Model.Product.Price)) * 100, 0);
                            <div class="text-decoration-line-through text-muted">R$ @Model.Product.Price.ToString("N2")</div>
                            <div class="h3 text-danger fw-bold">R$ <span id="unitPrice">@Model.Product.DiscountedPrice.Value.ToString("N2")</span></div>
                            <div class="small text-muted">Total: R$ <span id="totalPrice">@Model.Product.DiscountedPrice.Value.ToString("N2")</span></div>
                            <span class="badge bg-danger">-@(discountPercent)% de desconto</span>
                        }
                        else
                        {
                            <div class="h3 text-warning fw-bold">R$ <span id="unitPrice">@Model.Product.Price.ToString("N2")</span></div>
                            <div class="small text-muted">Total: R$ <span id="totalPrice">@Model.Product.Price.ToString("N2")</span></div>
                        }
                        <small class="text-success">À vista no PIX com 7% de desconto</small>
                    </div>

                    <!-- Parcelamento -->
                    <div class="mb-3">
                        @{
                            var installmentPrice = Model.Product.HasDiscount && Model.Product.DiscountedPrice.HasValue ? 
                                Model.Product.DiscountedPrice.Value * 1.05m : 
                                Model.Product.Price * 1.05m;
                        }
                        <p class="mb-1">R$ @(installmentPrice.ToString("N2")) em até 10x de R$ @((installmentPrice / 10).ToString("N2")) sem juros</p>
                        <small class="text-muted">ou 1x com 7% de desconto no cartão</small>
                        <br>
                        <a href="#" class="text-decoration-none">Ver mais opções de pagamento e parcelamento</a>
                    </div>

                    <!-- Disponibilidade -->
                    <div class="mb-3">
                        <span class="badge bg-success">
                            <i class="fas fa-check me-1"></i>Em estoque
                        </span>
                    </div>

                    <!-- Quantidade -->
                    <div class="mb-3">
                        <label for="quantity" class="form-label">Quantidade:</label>
                        <div class="input-group">
                            <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(-1)">-</button>
                            <input type="number" class="form-control text-center" id="quantity" value="1" min="1" max="@Model.Product.StockQuantity" >
                            <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(1)">+</button>
                        </div>
                    </div>

                    <!-- Botões de Ação -->
                    <div class="d-grid gap-2">
                        @if (Context.Session.GetInt32("UserId").HasValue)
                        {
                            <button class="btn btn-warning btn-lg" onclick="addToCartFromHome(@Model.Product.Id)">
                                <i class="fas fa-shopping-cart me-2"></i>Adicionar ao Carrinho
                            </button>
                            @if (Context.Session.GetString("UserRole") == "Admin")
                            {
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Edit", "Product", new { id = Model.Product.Id })" class="btn btn-outline-primary">
                                        <i class="fas fa-edit me-2"></i>Editar
                                    </a>
                                    <a href="@Url.Action("Delete", "Product", new { id = Model.Product.Id })" class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-2"></i>Excluir
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <button type="button" class="btn btn-warning btn-lg" onclick="redirectToLogin()">
                                <i class="fas fa-sign-in-alt me-2"></i>FAZER LOGIN PARA COMPRAR
                            </button>
                        }
                    </div>


                    <!-- Frete -->
                    <div class="border-top pt-3">
                        <h6 class="mb-2">
                            <i class="fas fa-truck me-2"></i>CONSULTE FRETE
                        </h6>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Inserir CEP*" id="cepInput">
                            <button class="btn btn-outline-primary" type="button" onclick="consultarFrete()">OK</button>
                        </div>
                        <small class="text-muted">
                            <a href="https://www.google.com/maps" class="text-decoration-none">Não lembro meu CEP</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .product-gallery .main-image-container {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 10px;
        text-align: center;
    }

    .product-gallery .main-image-container img {
        max-height: 400px;
        object-fit: contain;
    }

    .thumbnail-item {
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .thumbnail-item:hover {
        transform: scale(1.05);
    }

    .thumbnail-item.active {
        border: 2px solid #ffc107 !important;
    }

    .variation-item .btn {
        min-width: 80px;
    }

    .sticky-top {
        z-index: 1020;
    }

    .breadcrumb a {
        color: #ffc107;
        text-decoration: none;
    }

    .breadcrumb a:hover {
        color: #e0a800;
    }
</style>

<script>
    function changeMainImage(element, imageSrc) {
        // Remover classe active de todas as miniaturas
        document.querySelectorAll('.thumbnail-item').forEach(item => item.classList.remove('active'));
        
        // Adicionar classe active na miniatura clicada
        element.classList.add('active');
        
        // Alterar imagem principal
        document.getElementById('mainImage').src = imageSrc;
    }

    function changeQuantity(delta) {
        const input = document.getElementById('quantity');
        const newValue = parseInt(input.value) + delta;
        if (newValue >= 1 && newValue <= @Model.Product.StockQuantity) {
            input.value = newValue;
            const selected = document.querySelector('input[name="variationId"]:checked');
            const modifier = parseFloat(selected?.getAttribute('data-modifier') || '0') || 0;
            const base = parseFloat('@Model.Product.Price'.replace(',', '.'));
            updatePrices(base, modifier);
        }
    }

    function addToCart() {
        const quantity = parseInt(document.getElementById('quantity').value);
        const variationId = document.querySelector('input[name="variationId"]:checked')?.value;
        
        const data = {
            productId: @Model.Product.Id,
            variationId: variationId ? parseInt(variationId) : null,
            quantity: quantity
        };

        fetch('@Url.Action("AddToCart", "Cart")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showAlert('success', data.message);
                // Redirecionar para o carrinho após 1 segundo
                if (data.redirectToCart) {
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "Cart")';
                    }, 1000);
                }
            } else {
                if (data.requireLogin) {
                    showAlert('warning', 'Faça login para continuar comprando');
                    // Redirecionar para login após 2 segundos
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Login", "Auth")?returnUrl=' + encodeURIComponent(window.location.pathname);
                    }, 2000);
                } else {
                    showAlert('danger', data.message);
                }
            }
        })
        .catch(error => {
            console.error('Erro:', error);
            showAlert('danger', 'Erro ao adicionar ao carrinho');
        });
    }

    function consultarFrete() {
        const cep = document.getElementById('cepInput').value;
        if (cep.length === 8) {
            showAlert('info', 'Calculando frete para CEP ' + cep + '...');
            // Aqui você implementaria a lógica de cálculo de frete
        } else {
            showAlert('warning', 'Digite um CEP válido (8 dígitos)');
        }
    }

    function showAlert(type, message) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        alertDiv.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alertDiv);
        
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }

    function redirectToLogin() {
        window.location.href = '@Url.Action("Login", "Auth")?returnUrl=' + encodeURIComponent(window.location.pathname);
    }
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Obter o preço diretamente do modelo como número
        const basePrice = @Json.Serialize(Model.Product.HasDiscount && Model.Product.DiscountedPrice.HasValue ? Model.Product.DiscountedPrice.Value : Model.Product.Price);
        console.log('Preço base carregado do modelo:', basePrice, 'Tipo:', typeof basePrice);
        
        // Garantir que o preço base seja um número válido
        if (isNaN(basePrice)) {
            console.error('Erro: Preço base inválido');
            return;
        }
        
        // Inicializar os manipuladores com o preço base
        // Usando setTimeout para garantir que o DOM esteja totalmente carregado
        setTimeout(() => {
            bindVariationAndQuantityHandlers(basePrice);
        }, 100);
    });

             function addToCartFromHome(productId) {
               @if (!Context.Session.GetInt32("UserId").HasValue)
               {
                   <text>
                   const returnUrl = window.location.pathname + window.location.search;
                   window.location.href = '@Url.Action("Login", "Auth")?mustLoginToBuy=1&returnUrl=' + encodeURIComponent(returnUrl);
                   return;
                   </text>
               }
               // Se logado, segue fluxo normal
               let qt = document.getElementById("quantity").value
               if (qt <= 0){
                   qt = 0
               }
               
               // Obter a variação selecionada, se houver
               const variationSelect = document.querySelector('input[name="variationId"]:checked');
               const variationId = variationSelect ? parseInt(variationSelect.value) : null;
               
               const data = {
                   productId: productId,
                   variationId: variationId,
                   quantity: qt
               };
               
               console.log('Dados do carrinho:', data);

                fetch('@Url.Action("AddToCart", "Cart")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showAlert('success', 'Produto adicionado ao carrinho!');
                    } else {
                        if (data.requireLogin) {
                            const returnUrl = window.location.pathname + window.location.search;
                            window.location.href = '@Url.Action("Login", "Auth")?mustLoginToBuy=1&returnUrl=' + encodeURIComponent(returnUrl);
                        } else {
                            showAlert('danger', data.message);
                        }
                    }
                })
                .catch(error => {
                    console.error('Erro:', error);
                    showAlert('danger', 'Erro de conexão ao adicionar ao carrinho');
                });
            }
</script>
