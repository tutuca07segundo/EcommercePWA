@model EcommercePWA.Models.Product
@{
    ViewData["Title"] = "Editar Produto";
    var products = ViewBag.Products as List<EcommercePWA.Models.Product>;
    var categories = ViewBag.Categories as List<EcommercePWA.Models.Category>;
}

@if (Context.Session.GetString("UserRole") != "Admin")
{
    <div class="alert alert-danger mt-4">Acesso restrito: apenas administradores podem editar produtos.</div>
    return;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="fas fa-edit me-2"></i>Selecionar Produto para Editar
                    </h4>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="EditSelector">
                        <div class="mb-3">
                            <label for="productSelect" class="form-label">Produto</label>
                            <select id="productSelect" name="id" class="form-select" onchange="this.form.submit()">
                                <option value="">Selecione um produto...</option>
                                @foreach (var p in products)
                                {
                                    if (Model != null && Model.Id == p.Id)
                                    {
                                        <option value="@p.Id" selected>@p.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Id > 0)
            {
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-pen me-2"></i>Editar Produto: @Model.Name
                        </h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="EditSelector" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Name" class="form-label">Nome do Produto *</label>
                                        <input asp-for="Name" class="form-control" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Brand" class="form-label">Marca *</label>
                                        <input asp-for="Brand" class="form-control" />
                                        <span asp-validation-for="Brand" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Descrição *</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Category" class="form-label">Categoria *</label>
                                        <select asp-for="Category" class="form-select">
                                            <option value="">Selecione uma categoria</option>
                                            @foreach (var category in categories)
                                            {
                                                if (Model.Category == category.Name)
                                                {
                                                    <option value="@category.Name" selected>@category.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@category.Name">@category.Name</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="Category" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Type" class="form-label">Tipo *</label>
                                        <select asp-for="Type" class="form-select">
                                            <option value="">Selecione o tipo</option>
                                            @if (Model.Type == "Periférico")
                                            {
                                                <option value="Periférico" selected>Periférico</option>
                                            }
                                            else
                                            {
                                                <option value="Periférico">Periférico</option>
                                            }
                                            @if (Model.Type == "Peça")
                                            {
                                                <option value="Peça" selected>Peça</option>
                                            }
                                            else
                                            {
                                                <option value="Peça">Peça</option>
                                            }
                                            @if (Model.Type == "Acessório")
                                            {
                                                <option value="Acessório" selected>Acessório</option>
                                            }
                                            else
                                            {
                                                <option value="Acessório">Acessório</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Type" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="StockQuantity" class="form-label">Estoque *</label>
                                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Price" class="form-label">Preço (R$) *</label>
                                        <div class="input-group">
                                            <span class="input-group-text">R$</span>
                                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ImageUrl" class="form-label">URL da Imagem</label>
                                        <input asp-for="ImageUrl" class="form-control" />
                                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Tags" class="form-label">Tags</label>
                                <input asp-for="Tags" class="form-control" />
                                <span asp-validation-for="Tags" class="text-danger"></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Voltar
                                </a>
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save me-2"></i>Salvar Alterações
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
