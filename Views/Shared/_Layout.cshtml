<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kaboom</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommercePWA.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body data-user-authenticated="@(Context.Session.GetInt32("UserId").HasValue ? "True" : "False")" data-user-id="@(Context.Session.GetInt32("UserId"))" data-user-email="@(Context.Session.GetString("UserEmail"))" data-debug="@(Context.Session.GetInt32("UserId").HasValue ? $"Logado-{Context.Session.GetInt32("UserId")}" : "NaoLogado")">
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid px-0">
            <a class="navbar-brand fs-2 me-4 ms-0" href="@Url.Action("Index", "Home")">
                <i class="fas fa-bolt text-warning"></i> Kaboom
            </a>
            
            <div class="navbar-nav ms-auto">
                <a href="@Url.Action("Index", "Tracking")" class="btn btn-outline-success btn-sm me-2">
                    <i class="fas fa-search-location"></i> Rastrear
                </a>
                @if (Context.Session.GetInt32("UserId").HasValue)
                {
                    <a href="@Url.Action("Index", "Wishlist")" class="btn btn-outline-danger btn-sm me-2 position-relative">
                        <i class="fas fa-heart"></i> Lista de Desejos
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="wishlist-count" style="display: none;">
                            0
                        </span>
                    </a>
                    <span class="navbar-text me-3">
                        <i class="fas fa-user text-warning"></i> 
                        @Context.Session.GetString("UserEmail")
                    </span>
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-info btn-sm me-2">
                            <i class="fas fa-tachometer-alt"></i> Admin
                        </a>
                    }
                    <form method="post" action="@Url.Action("Logout", "Auth")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-sign-out-alt"></i> Sair
                        </button>
                    </form>
                }
                else
                {
                    <a href="@Url.Action("Login", "Auth")" class="btn btn-outline-warning btn-sm me-2">
                        <i class="fas fa-sign-in-alt"></i> Entrar
                    </a>
                    <a href="@Url.Action("Register", "Auth")" class="btn btn-warning btn-sm">
                        <i class="fas fa-user-plus"></i> Cadastrar
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container text-center">
            <p>&copy; 2025 Kaboom. Todos os direitos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <style>
        .filter-checkboxes {
            max-height: 150px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            padding: 0.5rem;
        }
        
        .suggestion-item:hover {
            background-color: #f8f9fa !important;
        }
        
        .product-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        
        .wishlist-btn:hover {
            background-color: #fff !important;
            border-color: #dc3545 !important;
        }
        
        .wishlist-btn:hover i {
            color: #dc3545 !important;
        }
        
        .badge .btn-close {
            font-size: 0.6em;
            opacity: 0.8;
        }
        
        .badge .btn-close:hover {
            opacity: 1;
        }
        
        #searchSuggestions {
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 0.375rem 0.375rem;
        }
        
        .pagination .page-link {
            color: #ffc107;
            border-color: #ffc107;
        }
        
        .pagination .page-item.active .page-link {
            background-color: #ffc107;
            border-color: #ffc107;
            color: #000;
        }
        
        .pagination .page-link:hover {
            background-color: #fff3cd;
            border-color: #ffc107;
            color: #000;
        }
    </style>
</body>
</html>
