@model EcommercePWA.Models.Subcategory

@{
    ViewData["Title"] = "Excluir Subcategoria";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-trash me-2"></i>Excluir Subcategoria
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Atenção!</strong> Esta ação não pode ser desfeita.
                    </div>

                    <h5>Tem certeza que deseja excluir esta subcategoria?</h5>
                    
                    <div class="row mt-4">
                        <div class="col-sm-4"><strong>Nome:</strong></div>
                        <div class="col-sm-8">@Model.Name</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4"><strong>Categoria:</strong></div>
                        <div class="col-sm-8">@Model.Category.Name</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4"><strong>Descrição:</strong></div>
                        <div class="col-sm-8">@Model.Description</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4"><strong>Produtos:</strong></div>
                        <div class="col-sm-8">
                            <span class="badge bg-info">@Model.Products.Count produto(s)</span>
                        </div>
                    </div>

                    @if (Model.Products.Any())
                    {
                        <div class="alert alert-info mt-3">
                            <i class="fas fa-info-circle me-2"></i>
                            Os produtos desta subcategoria não serão excluídos, apenas desvinculados.
                        </div>
                    }

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Confirmar Exclusão
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
