@model List<EcommercePWA.Models.WishlistItem>
@{
    ViewData["Title"] = "Lista de Desejos";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-heart text-danger"></i> Minha Lista de Desejos</h2>
                @if (Model.Any())
                {
                    <button class="btn btn-outline-danger" onclick="clearWishlist()">
                        <i class="fas fa-trash"></i> Limpar Lista
                    </button>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-heart-broken fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">Sua lista de desejos está vazia</h4>
                    <p class="text-muted">Adicione produtos que você gostaria de comprar mais tarde!</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="fas fa-shopping-bag"></i> Continuar Comprando
                    </a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        var finalPrice = item.Product.Price;
                        if (item.ProductVariation != null && item.ProductVariation.PriceModifier.HasValue)
                        {
                            finalPrice += item.ProductVariation.PriceModifier.Value;
                        }

                        <div class="col-lg-4 col-md-6 mb-4" id="wishlist-item-@item.Id">
                            <div class="card h-100 shadow-sm">
                                <div class="position-relative">
                                    <img src="@(!string.IsNullOrEmpty(item.Product.ImageUrl) ? item.Product.ImageUrl : "/images/placeholder.jpg")" 
                                         class="card-img-top" alt="@item.Product.Name" style="height: 200px; object-fit: cover;">
                                    
                                    <!-- Botão de remover -->
                                    <button class="btn btn-danger btn-sm position-absolute" 
                                            style="top: 10px; right: 10px; border-radius: 50%; width: 35px; height: 35px;"
                                            onclick="removeFromWishlist(@item.ProductId, @(item.ProductVariationId.HasValue ? item.ProductVariationId.Value.ToString() : "null"))"
                                            title="Remover dos favoritos">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title">@item.Product.Name</h6>
                                    
                                    @if (item.ProductVariation != null)
                                    {
                                        <small class="text-muted mb-2">
                                            <strong>Variação:</strong> @item.ProductVariation.Name
                                            @if (!string.IsNullOrEmpty(item.ProductVariation.Type))
                                            {
                                                <span> (@item.ProductVariation.Type)</span>
                                            }
                                        </small>
                                    }

                                    <p class="card-text text-muted small">@item.Product.Category > @item.Product.Brand</p>
                                    
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="h5 text-success mb-0">R$ @finalPrice.ToString("F2")</span>
                                            <small class="text-muted">@item.AddedAt.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        
                                        <div class="d-grid gap-2">
                                            <button class="btn btn-primary btn-sm" 
                                                    onclick="addToCartFromWishlist(@item.ProductId, @(item.ProductVariationId.HasValue ? item.ProductVariationId.Value.ToString() : "null"))">
                                                <i class="fas fa-shopping-cart"></i> Adicionar ao Carrinho
                                            </button>
                                            <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" 
                                               class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-eye"></i> Ver Detalhes
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                        <i class="fas fa-shopping-bag"></i> Continuar Comprando
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<script>
function removeFromWishlist(productId, variationId) {
    $.post('@Url.Action("Remove", "Wishlist")', {
        productId: productId,
        variationId: variationId
    })
    .done(function(response) {
        if (response.success) {
            // Remove o card da tela
            if (variationId) {
                $(`#wishlist-item-${productId}-${variationId}`).fadeOut(300, function() {
                    $(this).remove();
                    checkEmptyWishlist();
                });
            } else {
                $(`[id^="wishlist-item-"][id*="${productId}"]`).fadeOut(300, function() {
                    $(this).remove();
                    checkEmptyWishlist();
                });
            }
            
            // Atualiza contador no header
            updateWishlistCount(response.count);
            
            // Mostra notificação
            showNotification(response.message, 'success');
        } else {
            showNotification(response.message, 'error');
        }
    })
    .fail(function() {
        showNotification('Erro ao remover produto dos favoritos', 'error');
    });
}

function addToCartFromWishlist(productId, variationId) {
    // Mostrar loading no botão
    const button = event.target.closest('button');
    const originalText = button.innerHTML;
    const cardElement = button.closest('.col-lg-4');
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adicionando...';
    
    $.post('@Url.Action("AddToCart", "Wishlist")', {
        productId: productId,
        variationId: variationId
    })
    .done(function(response) {
        if (response.success) {
            // Remove o card da tela usando o elemento correto
            $(cardElement).fadeOut(300, function() {
                $(this).remove();
                checkEmptyWishlist();
            });
            
            // Atualiza contador no header
            updateWishlistCount(response.wishlistCount);
            
            // Mostra notificação
            showNotification(response.message, 'success');
        } else {
            showNotification(response.message, 'error');
            // Restaurar botão em caso de erro
            button.disabled = false;
            button.innerHTML = originalText;
        }
    })
    .fail(function() {
        showNotification('Erro ao adicionar produto ao carrinho', 'error');
        // Restaurar botão em caso de erro
        button.disabled = false;
        button.innerHTML = originalText;
    });
}

function clearWishlist() {
    if (confirm('Tem certeza que deseja limpar toda a lista de desejos?')) {
        $.post('@Url.Action("Clear", "Wishlist")')
        .done(function(response) {
            if (response.success) {
                location.reload();
            } else {
                showNotification(response.message, 'error');
            }
        })
        .fail(function() {
            showNotification('Erro ao limpar lista de desejos', 'error');
        });
    }
}

function checkEmptyWishlist() {
    if ($('[id^="wishlist-item-"]').length === 0) {
        setTimeout(function() {
            location.reload();
        }, 500);
    }
}

function updateWishlistCount(count) {
    const badge = $('#wishlist-count');
    if (count > 0) {
        badge.text(count).show();
    } else {
        badge.hide();
    }
}

function showNotification(message, type) {
    // Implementação básica de notificação
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const notification = `
        <div class="alert ${alertClass} alert-dismissible fade show position-fixed" 
             style="top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    `;
    
    $('body').append(notification);
    
    // Remove automaticamente após 3 segundos
    setTimeout(function() {
        $('.alert').fadeOut(300, function() {
            $(this).remove();
        });
    }, 3000);
}
</script>
