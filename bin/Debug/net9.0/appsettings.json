{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EcommerceSettings": {
    "StoreName": "Kaboom",
    "StoreDescription": "E-commerce de Periféricos e Peças de Computador",
    "Currency": "BRL",
    "CurrencySymbol": "R$",
    "DefaultPageSize": 12,
    "MaxSearchResults": 100,
    "EnableLiveSearch": true,
    "EnableProductComparison": true,
    "EnableWishlist": true,
    "EnableReviews": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=products.db"
  }
}
